---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Lightbox from '../components/Lightbox.astro';
import { translations } from '../i18n/translations';
import { Icon } from 'astro-icon/components';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Pedro Paiva Ferreira — Desenvolvedor Web & Soluções Full-Stack',
  description = 'Portfólio de Pedro Paiva Ferreira — desenvolvimento de sistemas web sob medida, automações desktop, SaaS e landing pages de alta conversão.',
} = Astro.props;

const i18nJson = JSON.stringify(translations);
---

<!doctype html>
<html lang="pt-BR" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f8fafc" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="apple-mobile-web-app-title" content="Pedro.dev" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>

    <!-- Theme restore script before render to avoid FOUC -->
    <script is:inline>
      (function() {
        const saved = localStorage.getItem('theme');
        if (saved === 'light' || saved === 'dark') {
          document.documentElement.dataset.theme = saved;
        } else {
          document.documentElement.dataset.theme = 'light';
        }
      })();
    </script>
    <script is:inline set:html={`window.__I18N__ = ${i18nJson};`}></script>
  </head>
  <body>
    <div class="scroll-progress"></div>
    <Nav />
    <main>
      <slot />
    </main>
    <Footer />

    <Lightbox />

    <!-- Persistent Floating WhatsApp Button for Instant Lead Conversion -->
    <a
      href="https://wa.me/5532984019757?text=Ol%C3%A1%20Pedro%2C%20gostaria%20de%20solicitar%20um%20or%C3%A7amento"
      target="_blank"
      rel="noopener"
      class="floating-wa-btn"
      aria-label="Falar no WhatsApp"
      title="Falar no WhatsApp"
    >
      <Icon name="simple-icons:whatsapp" width="26" height="26" />
      <span class="wa-tooltip">Solicitar Orçamento</span>
    </a>

    <script>
      // --- i18n: runtime language switching ---
      type Lang = 'pt' | 'en' | 'es';
      type Dict = Record<string, string>;
      const I18N = (window as any).__I18N__ as Record<Lang, Dict>;
      const VALID: Lang[] = ['pt', 'en', 'es'];
      const STORAGE_KEY = 'lang';

      const getLang = (): Lang => {
        const saved = localStorage.getItem(STORAGE_KEY) as Lang | null;
        if (saved && VALID.includes(saved)) return saved;
        const nav = (navigator.language || 'pt').slice(0, 2).toLowerCase();
        if (nav === 'en') return 'en';
        if (nav === 'es') return 'es';
        return 'pt';
      };

      // Safe HTML renderer: only allows <strong> and <em>.
      const applySafeHtml = (el: Element, html: string) => {
        while (el.firstChild) el.removeChild(el.firstChild);
        const re = /<(strong|em)>([\s\S]*?)<\/\1>/g;
        let lastIdx = 0;
        for (const match of html.matchAll(re)) {
          const idx = match.index ?? 0;
          if (idx > lastIdx) {
            el.appendChild(document.createTextNode(html.slice(lastIdx, idx)));
          }
          const tag = document.createElement(match[1]);
          tag.textContent = match[2];
          el.appendChild(tag);
          lastIdx = idx + match[0].length;
        }
        if (lastIdx < html.length) {
          el.appendChild(document.createTextNode(html.slice(lastIdx)));
        }
      };

      const applyLang = (lang: Lang) => {
        const dict = I18N[lang] || I18N.pt;
        document.documentElement.lang =
          lang === 'pt' ? 'pt-BR' : lang === 'en' ? 'en-US' : 'es-ES';

        document.querySelectorAll<HTMLElement>('[data-i18n]').forEach((el) => {
          const key = el.dataset.i18n;
          if (key && dict[key] !== undefined) el.textContent = dict[key];
        });

        document.querySelectorAll<HTMLElement>('[data-i18n-html]').forEach((el) => {
          const key = el.dataset.i18nHtml;
          if (key && dict[key] !== undefined) applySafeHtml(el, dict[key]);
        });

        document.querySelectorAll<HTMLElement>('[data-i18n-aria]').forEach((el) => {
          const key = el.dataset.i18nAria;
          if (key && dict[key] !== undefined) el.setAttribute('aria-label', dict[key]);
        });

        const t = dict['doc.title'];
        if (t) document.title = t;
        const meta = document.querySelector<HTMLMetaElement>('meta[name="description"]');
        if (meta && dict['doc.description']) meta.content = dict['doc.description'];

        document.querySelectorAll<HTMLButtonElement>('[data-lang-switch] [data-lang]').forEach((btn) => {
          btn.setAttribute('aria-pressed', btn.dataset.lang === lang ? 'true' : 'false');
        });

        localStorage.setItem(STORAGE_KEY, lang);
        document.dispatchEvent(new CustomEvent('langchange', { detail: { lang } }));
      };

      applyLang(getLang());

      document
        .querySelectorAll<HTMLButtonElement>('[data-lang-switch] [data-lang]')
        .forEach((btn) => {
          btn.addEventListener('click', () => {
            const lang = btn.dataset.lang as Lang;
            if (lang && VALID.includes(lang)) applyLang(lang);
          });
        });

      // --- Reveal on scroll ---
      const revealObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              revealObserver.unobserve(entry.target);
            }
          });
        },
        { threshold: 0, rootMargin: '0px 0px -80px 0px' }
      );

      document
        .querySelectorAll('.reveal, .rise')
        .forEach((el) => revealObserver.observe(el));

      // --- Nav compaction on scroll ---
      const nav = document.querySelector('[data-nav]');
      if (nav) {
        const onScroll = () => {
          if (window.scrollY > 24) nav.classList.add('is-scrolled');
          else nav.classList.remove('is-scrolled');
        };
        window.addEventListener('scroll', onScroll, { passive: true });
        onScroll();
      }
    </script>
  </body>
</html>

<style is:global>
  .floating-wa-btn {
    position: fixed;
    bottom: 1.5rem;
    right: 1.5rem;
    z-index: 55;
    width: 52px;
    height: 52px;
    border-radius: 999px;
    background: #25d366;
    color: #031e0b;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 8px 24px rgba(37, 211, 102, 0.4);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
    text-decoration: none;
  }

  .floating-wa-btn:hover {
    transform: scale(1.08) translateY(-2px);
    box-shadow: 0 12px 32px rgba(37, 211, 102, 0.6);
  }

  .wa-tooltip {
    position: absolute;
    right: 62px;
    background: var(--bg-elev);
    backdrop-filter: blur(8px);
    color: var(--text);
    padding: 0.4rem 0.8rem;
    border-radius: 0.5rem;
    font-size: 0.8rem;
    font-weight: 600;
    white-space: nowrap;
    border: 1px solid var(--border);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease, transform 0.2s ease;
    transform: translateX(6px);
    box-shadow: var(--shadow-md);
  }

  .floating-wa-btn:hover .wa-tooltip {
    opacity: 1;
    transform: translateX(0);
  }
</style>
