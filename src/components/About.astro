---
import SectionTitle from './SectionTitle.astro';
import { Icon } from 'astro-icon/components';

const highlights = [
  { icon: 'lucide:rocket', titleKey: 'about.h1.title', textKey: 'about.h1.text', title: 'Produtos em Produção', text: 'SmartParkJF e ReservaQuadra rodando com usuários reais.' },
  { icon: 'lucide:briefcase', titleKey: 'about.h2.title', textKey: 'about.h2.text', title: 'MB Contabilidade', text: 'Suporte de TI e Desenvolvedor de Soluções desde 2025.' },
  { icon: 'lucide:graduation-cap', titleKey: 'about.h3.title', textKey: 'about.h3.text', title: 'Formação Acadêmica', text: 'Sistemas de Informação — UniAcademia (7º período).' },
  { icon: 'lucide:languages', titleKey: 'about.h4.title', textKey: 'about.h4.text', title: 'Inglês B2 Técnico', text: 'Leitura fluente de documentações e comunicação assertiva.' },
];
---

<section id="sobre" class="section">
  <div class="container-page">
    <SectionTitle
      eyebrow="Sobre Pedro Paiva"
      title="Engenharia de Software com foco em resolver problemas reais"
      lead="Baseado em Juiz de Fora - MG, ajudo empresas e empreendedores a transformar necessidades de negócio em produtos digitais de alta performance."
      eyebrowKey="about.eyebrow"
      titleKey="about.title"
      leadKey="about.lead"
    />

    <div class="about-grid">
      <div class="about-text reveal">
        <p data-i18n-html="about.p1">
          Sou movido pela criação de <strong>soluções eficientes e bem arquitetadas</strong>. Acredito que um bom software deve resolver dores reais, economizar horas de trabalho manual e proporcionar uma experiência simples e agradável para o usuário final.
        </p>
        <p data-i18n-html="about.p2">
          Atualmente atuo na <strong>MB Contabilidade</strong> como Desenvolvedor de Soluções e Suporte de TI, onde projetei e implementei aplicações internas como o <strong>MBChat</strong> e a plataforma <strong>CentralMB</strong> (React + Supabase + Electron). Em paralelo, mantenho produtos SaaS comerciais em produção.
        </p>
        <p data-i18n-html="about.p3">
          Estudo <strong>Sistemas de Informação na UniAcademia</strong> (7º período) e possuo formação Full-Stack pela Codi Academy. Proatividade, comunicação transparente e velocidade na entrega são os pilares de cada projeto que assumo.
        </p>
      </div>

      <div class="about-highlights">
        {highlights.map((h, i) => (
          <div class="highlight reveal" style={`--reveal-delay: ${i * 90}ms`}>
            <span class="highlight-icon">
              <Icon name={h.icon} width="20" height="20" />
            </span>
            <div>
              <h3 class="highlight-title" data-i18n={h.titleKey}>{h.title}</h3>
              <p class="highlight-text" data-i18n={h.textKey}>{h.text}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .section {
    padding: clamp(3.5rem, 8vw, 6rem) 0;
    position: relative;
  }

  .about-grid {
    display: grid;
    gap: 3rem;
    grid-template-columns: 1fr;
  }

  @media (min-width: 900px) {
    .about-grid {
      grid-template-columns: 1.1fr 1fr;
    }
  }

  .about-text {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    color: var(--text-muted);
    font-size: 1.05rem;
    line-height: 1.75;
  }

  .about-text strong {
    color: var(--text);
    font-weight: 700;
  }

  .about-highlights {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  @media (min-width: 560px) {
    .about-highlights {
      grid-template-columns: 1fr 1fr;
    }
  }

  .highlight {
    display: flex;
    gap: 1rem;
    padding: 1.3rem;
    border: 1px solid var(--border);
    border-radius: 0.95rem;
    background: var(--bg-elev);
    box-shadow: var(--shadow-sm);
    transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
  }

  .highlight:hover {
    transform: translateY(-3px);
    border-color: rgba(16, 185, 129, 0.4);
    box-shadow: var(--shadow-md);
  }

  .highlight-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border-radius: 0.65rem;
    background: rgba(16, 185, 129, 0.12);
    color: var(--accent);
    flex-shrink: 0;
  }

  .highlight-title {
    font-weight: 700;
    font-size: 0.98rem;
    margin-bottom: 0.25rem;
    color: var(--text);
  }

  .highlight-text {
    font-size: 0.85rem;
    color: var(--text-muted);
    line-height: 1.5;
  }
</style>
