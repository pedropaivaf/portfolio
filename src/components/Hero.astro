---
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import avatar from '../assets/perfil.jpg';
---

<section id="top" class="hero">
  <div class="hero-bg" aria-hidden="true"></div>
  <div class="hero-glow-1" aria-hidden="true"></div>
  <div class="hero-glow-2" aria-hidden="true"></div>

  <div class="container-page hero-inner">
    <div class="hero-content">
      <h1 class="h-display rise" style="--reveal-delay: 80ms" data-i18n-html="hero.title">
        Desenvolvimento Web & Software <span class="text-accent">sob medida</span> para o seu negócio
      </h1>

      <p class="hero-bio reveal" style="--reveal-delay: 180ms" data-i18n="hero.bio">
        Transformo ideias e processos manuais em produtos digitais de alta performance — sistemas de gestão web, aplicações desktop com Electron, SaaS e landing pages otimizadas para converter visitantes em clientes.
      </p>

      <div class="hero-ctas reveal" style="--reveal-delay: 280ms">
        <a 
          href="https://wa.me/5532984019757?text=Ol%C3%A1%20Pedro%2C%20gostaria%20de%20solicitar%20um%20or%C3%A7amento%20para%20meu%20projeto" 
          target="_blank" 
          rel="noopener" 
          class="btn btn-whatsapp"
        >
          <Icon name="simple-icons:whatsapp" width="18" height="18" />
          <span data-i18n="hero.cta.whatsapp">Falar no WhatsApp</span>
        </a>
        <a href="#projetos" class="btn btn-ghost">
          <Icon name="lucide:arrow-down-right" width="18" height="18" />
          <span data-i18n="hero.cta.projects">Ver projetos em produção</span>
        </a>
      </div>

      <div class="hero-meta reveal" style="--reveal-delay: 380ms">
        <div class="meta-item">
          <Icon name="lucide:check-circle-2" width="16" height="16" class="meta-icon" />
          <span data-i18n="hero.meta.prod">Sistemas rodando em operação real</span>
        </div>
        <div class="meta-item">
          <Icon name="lucide:map-pin" width="16" height="16" class="meta-icon" />
          <span data-i18n="hero.meta.location">Juiz de Fora, MG (Atendimento Global)</span>
        </div>
      </div>
    </div>

    <!-- Editorial Glassmorphism Photo Showcase -->
    <div class="hero-visual reveal" style="--reveal-delay: 120ms">
      <div class="editorial-card">
        <div class="hero-photo-wrap">
          <Image src={avatar} alt="Pedro Paiva Ferreira" class="hero-photo" />
        </div>

        <div class="avatar-card-info">
          <h3 class="card-name">Pedro Paiva Ferreira</h3>
          <div class="card-role-wrap">
            <span class="role-pill">
              <span class="pill-dot"></span>
              <span>Desenvolvedor Full-Stack</span>
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-top: 7rem;
    padding-bottom: 4rem;
    overflow: hidden;
    min-height: calc(100vh - 4rem);
    display: flex;
    align-items: center;
  }

  @media (min-width: 960px) {
    .hero {
      padding-top: 8.5rem;
      padding-bottom: 5rem;
    }
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    background-image:
      radial-gradient(ellipse 60% 50% at 50% -10%, rgba(16, 185, 129, 0.15), transparent 70%),
      linear-gradient(to bottom, var(--hero-blend), var(--bg));
    pointer-events: none;
  }

  .hero-glow-1,
  .hero-glow-2 {
    position: absolute;
    border-radius: 999px;
    filter: blur(90px);
    opacity: 0.25;
    pointer-events: none;
    z-index: 0;
  }

  :global([data-theme="light"]) .hero-glow-1,
  :global([data-theme="light"]) .hero-glow-2 {
    opacity: 0.12;
  }

  .hero-glow-1 {
    width: 380px;
    height: 380px;
    background: #10b981;
    top: 5%;
    right: 5%;
  }

  .hero-glow-2 {
    width: 300px;
    height: 300px;
    background: #059669;
    bottom: 5%;
    left: -5%;
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: center;
  }

  @media (min-width: 960px) {
    .hero-inner {
      grid-template-columns: 1.25fr 0.85fr;
      gap: 3.5rem;
    }
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .text-accent {
    color: var(--accent);
    background: linear-gradient(135deg, var(--accent) 0%, var(--accent-strong) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-bio {
    font-size: clamp(1rem, 1.2vw, 1.15rem);
    color: var(--text-muted);
    max-width: 36rem;
    line-height: 1.7;
  }

  .hero-ctas {
    display: flex;
    gap: 0.85rem;
    flex-wrap: wrap;
    margin-top: 0.5rem;
  }

  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin-top: 1rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
    font-size: 0.88rem;
    color: var(--text-muted);
  }

  .meta-item {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .meta-icon {
    color: var(--accent);
  }

  .hero-visual {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .editorial-card {
    position: relative;
    width: 100%;
    max-width: 330px;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .hero-photo-wrap {
    width: 100%;
    aspect-ratio: 4 / 4.5;
    border-radius: 1.4rem;
    overflow: hidden;
    border: 1px solid var(--border);
    box-shadow: var(--shadow-lg);
    transition: transform 0.3s ease, border-color 0.3s ease;
    background: var(--bg-elev);
  }

  .hero-photo-wrap:hover {
    transform: translateY(-3px);
    border-color: rgba(16, 185, 129, 0.4);
  }

  .hero-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 20%;
  }

  .avatar-card-info {
    background: var(--bg-elev);
    backdrop-filter: blur(12px);
    border: 1px solid var(--border);
    border-radius: 1rem;
    padding: 1rem 1.2rem;
    box-shadow: var(--shadow-md);
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    transition: border-color 0.3s ease;
  }

  .editorial-card:hover .avatar-card-info {
    border-color: rgba(16, 185, 129, 0.3);
  }

  .card-name {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--text);
    line-height: 1.25;
  }

  .card-role-wrap {
    display: flex;
    align-items: center;
  }

  .role-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--accent-light);
  }

  .pill-dot {
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: var(--accent);
    box-shadow: 0 0 8px var(--accent);
    flex-shrink: 0;
  }
</style>
