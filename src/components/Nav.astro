---
import { Icon } from 'astro-icon/components';
// import LangSwitcher from './LangSwitcher.astro';

const links = [
  { href: '#servicos', label: 'Serviços', key: 'nav.servicos' },
  { href: '#projetos', label: 'Projetos', key: 'nav.projetos' },
  { href: '#processo', label: 'Processo', key: 'nav.processo' },
  { href: '#sobre', label: 'Sobre', key: 'nav.sobre' },
  { href: '#contato', label: 'Contato', key: 'nav.contato' },
];
---

<header class="nav-wrap" data-nav>
  <div class="container-page nav-inner">
    <a href="#top" class="brand" aria-label="Início">
      <span class="brand-name">Pedro Paiva<span class="brand-dot">.</span></span>
      <span class="brand-tag">&lt;dev/&gt;</span>
    </a>

    <nav class="nav-links" aria-label="Principal">
      {links.map((l) => (
        <a href={l.href} class="nav-link">
          <span data-i18n={l.key}>{l.label}</span>
        </a>
      ))}
    </nav>

    <div class="nav-right">
      <!-- Theme Toggle Button (Light/Dark Mode) -->
      <button
        type="button"
        class="theme-toggle-btn"
        data-theme-toggle
        aria-label="Alternar tema claro/escuro"
        title="Alternar tema claro/escuro"
      >
        <span class="theme-icon icon-sun">
          <Icon name="lucide:sun" width="18" height="18" />
        </span>
        <span class="theme-icon icon-moon">
          <Icon name="lucide:moon" width="18" height="18" />
        </span>
      </button>

      <!-- Language selector hidden from UI, preserved in codebase -->
      <!-- <LangSwitcher /> -->

      <a
        href="https://wa.me/5532984019757?text=Ol%C3%A1%20Pedro%2C%20quero%20solicitar%20um%20or%C3%A7amento"
        target="_blank"
        rel="noopener"
        class="btn btn-primary btn-sm nav-cta"
      >
        <Icon name="simple-icons:whatsapp" width="16" height="16" />
        <span data-i18n="nav.cta">Solicitar Orçamento</span>
      </a>
    </div>

    <button
      type="button"
      class="nav-burger"
      aria-label="Abrir menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-burger
    >
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>
</header>

<div class="mobile-menu" id="mobile-menu" data-mobile-menu aria-hidden="true">
  <div class="mobile-menu-inner">
    <span class="mobile-menu-eyebrow" data-i18n="nav.menu">Menu de Navegação</span>
    <nav class="mobile-menu-nav" aria-label="Mobile">
      {links.map((l, i) => (
        <a href={l.href} class="mobile-menu-link" style={`--mm-delay: ${i * 50}ms`}>
          <span class="mm-label" data-i18n={l.key}>{l.label}</span>
          <Icon name="lucide:arrow-right" width="18" height="18" class="mm-arrow" />
        </a>
      ))}
    </nav>
    <a
      href="https://wa.me/5532984019757?text=Ol%C3%A1%20Pedro%2C%20gostaria%20de%20solicitar%20um%20or%C3%A7amento"
      target="_blank"
      rel="noopener"
      class="btn btn-whatsapp mobile-menu-cta"
    >
      <Icon name="simple-icons:whatsapp" width="18" height="18" />
      <span data-i18n="nav.cta">Falar no WhatsApp</span>
    </a>
  </div>
</div>

<script>
  // Theme Toggle Handler
  const themeBtn = document.querySelector('[data-theme-toggle]');
  if (themeBtn) {
    const getTheme = () => document.documentElement.dataset.theme || 'light';
    const setTheme = (t: string) => {
      document.documentElement.dataset.theme = t;
      localStorage.setItem('theme', t);
    };
    themeBtn.addEventListener('click', () => {
      const next = getTheme() === 'dark' ? 'light' : 'dark';
      setTheme(next);
    });
  }

  // Burger Menu Handler
  const burger = document.querySelector('[data-burger]') as HTMLButtonElement | null;
  const menu = document.querySelector('[data-mobile-menu]') as HTMLElement | null;
  if (burger && menu) {
    const close = () => {
      burger.setAttribute('aria-expanded', 'false');
      menu.setAttribute('aria-hidden', 'true');
      menu.classList.remove('is-open');
      burger.classList.remove('is-open');
      document.body.style.overflow = '';
    };
    const toggle = () => {
      const isOpen = burger.getAttribute('aria-expanded') === 'true';
      if (isOpen) {
        close();
      } else {
        burger.setAttribute('aria-expanded', 'true');
        menu.setAttribute('aria-hidden', 'false');
        menu.classList.add('is-open');
        burger.classList.add('is-open');
        document.body.style.overflow = 'hidden';
      }
    };
    burger.addEventListener('click', toggle);
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', close));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') close();
    });
  }
</script>

<style>
  .nav-wrap {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    padding: 1.1rem 0;
    transition: padding 0.25s ease, background 0.25s ease, border-color 0.25s ease;
    border-bottom: 1px solid transparent;
  }

  .nav-wrap.is-scrolled {
    padding: 0.65rem 0;
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    background: color-mix(in oklab, var(--bg) 88%, transparent);
    border-bottom-color: var(--border);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--text);
    text-decoration: none;
  }

  .brand-name {
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text);
  }

  .brand-dot {
    color: var(--accent);
    font-weight: 900;
  }

  .brand-tag {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--accent);
    background: rgba(16, 185, 129, 0.1);
    border: 1px solid rgba(16, 185, 129, 0.25);
    padding: 0.15rem 0.45rem;
    border-radius: 0.4rem;
    letter-spacing: 0.03em;
  }

  .nav-links {
    display: none;
    gap: 2rem;
    font-size: 0.9rem;
    font-weight: 500;
  }

  @media (min-width: 768px) {
    .nav-links {
      display: inline-flex;
    }
  }

  .nav-link {
    position: relative;
    color: var(--text-muted);
    transition: color 0.2s ease;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 100%;
    bottom: -4px;
    height: 2px;
    background: var(--accent);
    transition: right 0.25s ease;
  }

  .nav-link:hover {
    color: var(--text);
  }

  .nav-link:hover::after {
    right: 0;
  }

  .nav-right {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
  }

  /* --- theme toggle button --- */
  .theme-toggle-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 0.6rem;
    background: var(--bg-elev);
    border: 1px solid var(--border);
    color: var(--text-muted);
    cursor: pointer;
    transition: transform 0.2s ease, border-color 0.2s ease, color 0.2s ease;
  }

  .theme-toggle-btn:hover {
    transform: translateY(-1px);
    border-color: var(--accent);
    color: var(--accent);
  }

  .theme-icon {
    display: none;
    align-items: center;
    justify-content: center;
  }

  :global([data-theme="dark"]) .icon-sun { display: flex; }
  :global([data-theme="dark"]) .icon-moon { display: none; }

  :global([data-theme="light"]) .icon-sun { display: none; }
  :global([data-theme="light"]) .icon-moon { display: flex; }

  /* Default when data-theme is unset (light) */
  :global(:root:not([data-theme])) .icon-sun { display: none; }
  :global(:root:not([data-theme])) .icon-moon { display: flex; }

  .nav-cta {
    display: none;
  }

  @media (min-width: 768px) {
    .nav-cta {
      display: inline-flex;
    }
  }

  /* --- burger --- */
  .nav-burger {
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 42px;
    height: 42px;
    padding: 10px;
    background: var(--bg-elev);
    border: 1px solid var(--border);
    border-radius: 0.6rem;
    cursor: pointer;
  }

  .nav-burger span {
    display: block;
    height: 2px;
    width: 100%;
    background: var(--text);
    border-radius: 2px;
    transition: transform 0.3s ease, opacity 0.2s ease;
  }

  .nav-burger.is-open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .nav-burger.is-open span:nth-child(2) { opacity: 0; }
  .nav-burger.is-open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  @media (min-width: 768px) {
    .nav-burger { display: none; }
  }

  /* --- mobile menu --- */
  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 49;
    background: color-mix(in oklab, var(--bg) 96%, transparent);
    backdrop-filter: blur(16px);
    display: flex;
    flex-direction: column;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }

  .mobile-menu.is-open {
    opacity: 1;
    visibility: visible;
  }

  @media (min-width: 768px) {
    .mobile-menu { display: none !important; }
  }

  .mobile-menu-inner {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding: 6rem 1.75rem 2.5rem;
    flex: 1;
  }

  .mobile-menu-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent);
  }

  .mobile-menu-nav {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    flex: 1;
  }

  .mobile-menu-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.1rem 0;
    border-bottom: 1px solid var(--border);
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--text);
  }

  .mm-arrow {
    color: var(--text-muted);
  }

  .mobile-menu-cta {
    margin-top: auto;
    justify-content: center;
    width: 100%;
  }
</style>
